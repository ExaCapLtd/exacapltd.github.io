---
// TODO: replace `placeholder` with the real Formspree form ID before launch —
// as it stands this endpoint silently discards every submission.
const FORM_ENDPOINT = 'https://formspree.io/f/placeholder';

const roles = [
  { value: 'founder', label: 'Founder looking for a technical partner' },
  { value: 'advisor', label: 'Advisor or operator who wants to help' },
];

const propositions = [
  {
    title: 'We build, we don’t just back',
    body: 'ExaDev engineers embed directly into portfolio companies — so the products get built, and what we know about the technology is first-hand.',
  },
  {
    title: 'Not a fund',
    body: 'ExaCap invests its own capital and its own engineering time. We don’t pool, hold, or manage anyone else’s money, and we’re not authorised by the FCA.',
  },
  {
    title: 'Domain-expert founders',
    body: 'B2B vertical software built by people who know their industry inside out, in sectors we understand well enough to be useful.',
  },
  {
    title: 'Skin in the game',
    body: 'We take stakes through joint ventures, founding equity, and sweat equity. If a company does not work, neither does our stake.',
  },
];
---

<section id="network" class="bg-accent-500 dark:bg-accent-900 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-sm font-semibold tracking-widest uppercase text-primary-400 mb-4">Network</p>
        <h2 class="text-4xl font-bold tracking-tight text-white">
          Work with ExaCap
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-gray-300">
          We back a small number of B2B software companies and build the products alongside their founders. Whether you want a technical partner or a way to put your own experience to work &mdash; tell us which and we'll take it from there.
        </p>

        <div class="mt-10 space-y-6">
          {propositions.map((item) => (
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-primary-400/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-primary-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              </div>
              <div>
                <h3 class="text-base font-semibold text-white">{item.title}</h3>
                <p class="text-sm text-gray-400">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 lg:mt-0">
        <div class="rounded-2xl bg-accent-600 dark:bg-accent-800 p-8 border border-gray-700">
          <h3 class="text-xl font-semibold text-white mb-6">Get in touch</h3>
          <form
            action={FORM_ENDPOINT}
            method="POST"
            class="space-y-5"
          >
            <fieldset>
              <legend class="block text-sm font-medium text-gray-300 mb-2.5">I'm a&hellip;</legend>
              <div class="space-y-2.5">
                {roles.map((role, i) => (
                  <label class="flex items-start gap-3 cursor-pointer group">
                    <input
                      type="radio"
                      name="role"
                      value={role.value}
                      required={i === 0}
                      class="mt-0.5 h-4 w-4 flex-shrink-0 border-gray-600 bg-accent-700 dark:bg-accent-900 text-primary-400 focus:ring-1 focus:ring-primary-400 focus:ring-offset-0"
                    />
                    <span class="text-sm text-gray-300 group-hover:text-white transition-colors">{role.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div>
              <label for="name" class="block text-sm font-medium text-gray-300 mb-1.5">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full rounded-lg border border-gray-600 bg-accent-700 dark:bg-accent-900 px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:border-primary-400 focus:ring-1 focus:ring-primary-400 focus:outline-none"
                placeholder="Jane Smith"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-lg border border-gray-600 bg-accent-700 dark:bg-accent-900 px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:border-primary-400 focus:ring-1 focus:ring-primary-400 focus:outline-none"
                placeholder="jane@example.com"
              />
            </div>
            <div>
              <label for="linkedin" class="block text-sm font-medium text-gray-300 mb-1.5">LinkedIn Profile <span class="text-gray-500">(optional)</span></label>
              <input
                type="url"
                id="linkedin"
                name="linkedin"
                class="w-full rounded-lg border border-gray-600 bg-accent-700 dark:bg-accent-900 px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:border-primary-400 focus:ring-1 focus:ring-primary-400 focus:outline-none"
                placeholder="https://linkedin.com/in/..."
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-300 mb-1.5">Tell us more</label>
              <textarea
                id="message"
                name="message"
                rows="3"
                class="w-full rounded-lg border border-gray-600 bg-accent-700 dark:bg-accent-900 px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:border-primary-400 focus:ring-1 focus:ring-primary-400 focus:outline-none resize-none"
                placeholder="What you're working on, or how you'd like to get involved..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full rounded-lg bg-primary-400 px-4 py-3 text-sm font-semibold text-secondary-500 hover:bg-primary-500 transition-colors"
            >
              Get in touch
            </button>
            <p class="text-xs text-gray-500">
              ExaCap Limited is not authorised or regulated by the Financial Conduct Authority. We invest our own capital and do not manage third-party money. Nothing on this page is an offer, invitation, or inducement to invest, or advice on the merits of any investment.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
